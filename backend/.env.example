# Copy to backend/.env and edit. Every setting is optional.

# ---- limits ----------------------------------------------------------------
# MAX_FILE_SIZE=10485760      # 10 MB per uploaded file
# MAX_BULK_FILES=25           # resumes per bulk batch

# ---- OCR -------------------------------------------------------------------
# Only used for scanned/image-only documents. Text-layer PDFs never touch OCR.
# OCR_ENGINE=rapidocr         # rapidocr (default) or easyocr

# ---- CORS ------------------------------------------------------------------
# Comma-separated allowed browser origins. "*" is the default so the frontend
# works from any local server. Narrow it if you expose the API beyond localhost.
# CORS_ORIGINS=http://localhost:5500

# ---- Optional AI enrichment ------------------------------------------------
# Off by default. The analyzer scores and ranks fixes entirely without it; the
# model only adds skills outside the catalog and rewrites weak bullets.
# Any OpenAI-compatible endpoint works.
#
# Ollama - free, open source, runs on your machine, nothing leaves it:
#   ollama pull llama3.1:8b && ollama serve
# LLM_ENABLED=true
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
#
# Groq - free tier, hosted open-source models, much faster:
# LLM_ENABLED=true
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_your_key_here
#
# OpenRouter - free-tier open models:
# LLM_ENABLED=true
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_API_KEY=sk-or-your_key_here
#
# LLM_TIMEOUT=45
